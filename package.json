{
  "name": "wellposed",
  "version": "0.7.0",
  "description": "Lint your jev requests before they come back confidently wrong.",
  "type": "module",
  "bin": {
    "wellposed": "skills/wellposed/scripts/wellposed.mjs"
  },
  "exports": {
    ".": "./skills/wellposed/scripts/structural.mjs",
    "./semantic": "./skills/wellposed/scripts/semantic.mjs"
  },
  "files": [
    "skills/",
    "README.md",
    "LICENSE",
    "!skills/wellposed/eval/semantic-raw.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test skills/wellposed/eval/",
    "eval": "node skills/wellposed/eval/agreement.mjs",
    "lint:example": "node skills/wellposed/scripts/wellposed.mjs lint skills/wellposed/examples/support-ticket.json",
    "eval:semantic": "node skills/wellposed/eval/semantic-agreement.mjs"
  },
  "keywords": [
    "typesafe",
    "jev",
    "system-one",
    "lint",
    "claude-code",
    "codex",
    "agent-skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suraj-phanindra/wellposed.git"
  }
}
